<?xml version="1.0" encoding="utf-8"?>
<!-- Takes Netflix's package name so the remote's Netflix button opens Nuvio instead. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.netflix.ninja"
    android:versionCode="3"
    android:versionName="1.2-nuvio-bridge-hidden">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: lets the bridge find Nuvio. -->
    <queries>
        <package android:name="com.nuvio.app" />
    </queries>

    <application
        android:label="Nuvio (Netflix button)"
        android:icon="@drawable/banner"
        android:banner="@drawable/banner"
        android:allowBackup="false">
        <activity
            android:name=".BridgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <!-- No LAUNCHER/LEANBACK_LAUNCHER filter: keeps the bridge out of the apps list. -->
            <!-- What the remote's Netflix button actually sends (seen in logcat on the Google TV Streamer). -->
            <intent-filter>
                <action android:name="com.netflix.action.NETFLIX_KEY_START" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
